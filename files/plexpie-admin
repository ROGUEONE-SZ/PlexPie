#!/bin/bash
# PlexPie admin helper: the only root actions the Settings page can trigger.
# Called by the plexpie daemon through sudo (see /etc/sudoers.d/plexpie).
set -uo pipefail
STATE=/var/lib/plexpie
LOG=/var/log/plexpie-update.log
REPO=$(cat /etc/plexpie/repo_dir 2>/dev/null || true)
U=$(stat -c %U "$REPO" 2>/dev/null || echo root)
mkdir -p "$STATE"

json_status() {   # step running(true/false) [extra json]
  printf '{"step":"%s","running":%s,"time":%s,"started":%s,"kind":"%s"%s}\n' "$1" "$2" "$(date +%s)" \
    "$(cat "$STATE/update-started" 2>/dev/null || echo 0)" "${KIND:-$(cat "$STATE/update-kind" 2>/dev/null)}" \
    "${3:-}" > "$STATE/update-run.json.tmp"
  mv -f "$STATE/update-run.json.tmp" "$STATE/update-run.json"
}

apt_progress() {  # reads apt's Status-Fd and reports an overall percent between $1 and $1+$2
  local base=$1 span=$2 fixed=${3:-} last=-1 kind pkg pct msg lab b sp p
  while IFS=: read -r kind pkg pct msg; do
    case "$kind" in
      dlstatus) lab="Downloading updates"; b=$base; sp=$((span * 3 / 10)) ;;
      pmstatus) lab="Installing updates"; b=$((base + span * 3 / 10)); sp=$((span * 7 / 10)) ;;
      *) continue ;;
    esac
    [ -n "$fixed" ] && { lab=$fixed; b=$base; sp=$span; }
    pct=${pct%%.*}; [[ "$pct" =~ ^[0-9]+$ ]] || pct=0
    p=$((b + pct * sp / 100))
    [ "$p" = "$last" ] && continue
    last=$p
    [ "$kind" = pmstatus ] || pkg=""                 # dlstatus gives a file number, not a package
    json_status "$lab" true ",\"percent\":$p,\"detail\":\"$(printf %s "$pkg" | tr -cd 'A-Za-z0-9._+-' | cut -c1-40)\""
  done
}

wait_reader() {   # let the progress reader finish writing ($! may be unset: never fail on it)
  [ -n "${!:-}" ] && wait "$!" 2>/dev/null
  sleep 0.3
  return 0
}

protect_active() { grep -Eq 'boot=overlay|overlayroot=tmpfs' /proc/cmdline; }

# The desktop's login screen PlexPie replaced (lightdm on Raspberry Pi OS, gdm on Ubuntu, sddm…)
DM=$(cat /etc/plexpie/display-manager 2>/dev/null || echo lightdm)

# Kernel boot options: cmdline.txt on a Raspberry Pi, GRUB on a PC
BOOTKIND=""; BOOTFILE=""
for f in /boot/firmware/cmdline.txt /boot/cmdline.txt; do [ -f "$f" ] && { BOOTKIND=pi; BOOTFILE=$f; break; }; done
[ -z "$BOOTKIND" ] && [ -f /etc/default/grub ] && { BOOTKIND=grub; BOOTFILE=/etc/default/grub; }
boot_line_get() {
  case "$BOOTKIND" in
    pi) head -n1 "$BOOTFILE" ;;
    grub) sed -n 's/^GRUB_CMDLINE_LINUX_DEFAULT=["'"'"']\{0,1\}\([^"'"'"']*\)["'"'"']\{0,1\}$/\1/p' "$BOOTFILE" | tail -1 ;;
  esac
}
boot_line_set() {   # boot_line_set "new options": keeps a copy of the old file
  cp -p "$BOOTFILE" "$BOOTFILE.plexpie-bak"
  case "$BOOTKIND" in
    pi) printf '%s\n' "$1" > "$BOOTFILE.plexpie-new" && mv "$BOOTFILE.plexpie-new" "$BOOTFILE" ;;
    grub)
      if grep -q '^GRUB_CMDLINE_LINUX_DEFAULT=' "$BOOTFILE"; then
        sed -i "s|^GRUB_CMDLINE_LINUX_DEFAULT=.*|GRUB_CMDLINE_LINUX_DEFAULT=\"$1\"|" "$BOOTFILE"
      else
        echo "GRUB_CMDLINE_LINUX_DEFAULT=\"$1\"" >> "$BOOTFILE"
      fi
      grub_update ;;
  esac
}
grub_update() { if command -v update-grub >/dev/null; then update-grub >/dev/null 2>&1; else grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1; fi || true; }
grub_set() {        # grub_set KEY VALUE: one GRUB setting, remembering the original
  local k=$1 v=$2
  grep -q "^$k=" "$STATE/grub-orig" 2>/dev/null || echo "$k=$(sed -n "s/^$k=//p" "$BOOTFILE" | tail -1)" >> "$STATE/grub-orig"
  if grep -q "^$k=" "$BOOTFILE"; then sed -i "s|^$k=.*|$k=$v|" "$BOOTFILE"; else echo "$k=$v" >> "$BOOTFILE"; fi
}
grub_restore() {    # put back the GRUB settings PlexPie changed
  [ -f "$STATE/grub-orig" ] || return 0
  while IFS='=' read -r k v; do
    [ -n "$k" ] || continue
    if [ -n "$v" ]; then sed -i "s|^$k=.*|$k=$v|" "$BOOTFILE"; else sed -i "/^$k=/d" "$BOOTFILE"; fi
  done < "$STATE/grub-orig"
  rm -f "$STATE/grub-orig"
}
plymouth_theme() {  # make the PlexPie start-up screen the default (and rebuild the start-up files)
  [ -d /usr/share/plymouth/themes/plexpie ] || return 0
  local sum; sum=$(cat /usr/share/plymouth/themes/plexpie/* 2>/dev/null | md5sum | cut -c1-32)
  [ "$(cat "$STATE/plymouth-theme.sum" 2>/dev/null)" = "$sum" ] && return 0
  if command -v plymouth-set-default-theme >/dev/null; then
    plymouth-set-default-theme -R plexpie >/dev/null 2>&1 || return 0
  else                                        # Ubuntu picks the theme with update-alternatives
    update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth \
      /usr/share/plymouth/themes/plexpie/plexpie.plymouth 200 >/dev/null 2>&1 &&
    update-alternatives --set default.plymouth /usr/share/plymouth/themes/plexpie/plexpie.plymouth >/dev/null 2>&1 &&
    update-initramfs -u >/dev/null 2>&1 || return 0
  fi
  echo "$sum" > "$STATE/plymouth-theme.sum"
}

case "${1:-}" in
  wifi-status)
    radio=$(nmcli -t -f WIFI g 2>/dev/null || echo unknown)
    ssid=$(nmcli -t -f ACTIVE,SSID dev wifi 2>/dev/null | awk -F: '$1=="yes"{print $2; exit}')
    ip=$(ip -4 -o addr show wlan0 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
    eth=$(ip -4 -o addr show eth0 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
    python3 -c 'import json,sys; print(json.dumps(dict(zip(["radio","ssid","ip","eth_ip"], sys.argv[1:]))))' \
      "$radio" "$ssid" "$ip" "$eth" ;;
  wifi-on)  nmcli radio wifi on ;;
  wifi-off) nmcli radio wifi off ;;
  wifi-scan)
    nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY dev wifi list --rescan yes 2>/dev/null | python3 -c '
import json, sys
seen = {}
for line in sys.stdin:
    parts = line.rstrip("\n").replace("\\:", "\x00").split(":")
    if len(parts) < 4 or not parts[1]:
        continue
    use, ssid, sig, sec = [p.replace("\x00", ":") for p in parts[:4]]
    if ssid not in seen or int(sig or 0) > seen[ssid]["signal"]:
        seen[ssid] = {"ssid": ssid, "signal": int(sig or 0), "secure": sec not in ("", "--"), "active": use == "*"}
print(json.dumps(sorted(seen.values(), key=lambda n: -n["signal"])[:20]))' ;;
  wifi-connect)
    ssid=${2:-}
    [ -n "$ssid" ] && [ ${#ssid} -le 32 ] && [[ "$ssid" != *$'\n'* ]] || { echo "bad network name" >&2; exit 2; }
    IFS= read -r pw || true          # password arrives on stdin, never on the command line
    name="plexpie-$(printf '%s' "$ssid" | tr -c 'A-Za-z0-9._-' '_')"
    f="/etc/NetworkManager/system-connections/$name.nmconnection"
    umask 077
    {
      printf '[connection]\nid=%s\ntype=wifi\ninterface-name=wlan0\nautoconnect=true\n\n' "$name"
      printf '[wifi]\nmode=infrastructure\nssid=%s\n\n' "$ssid"
      [ -n "$pw" ] && printf '[wifi-security]\nkey-mgmt=wpa-psk\npsk=%s\n\n' "$pw"
      printf '[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n'
    } > "$f"
    chmod 600 "$f"
    nmcli radio wifi on
    nmcli connection reload
    nmcli connection up id "$name" ;;
  check-plexpie)    # is there a newer PlexPie on GitHub? (quick: one git fetch)
    behind=0; latest=""; changes="[]"
    if [ -d "$REPO/.git" ]; then
      sudo -u "$U" git -C "$REPO" fetch -q 2>/dev/null
      behind=$(sudo -u "$U" git -C "$REPO" rev-list --count HEAD..@{u} 2>/dev/null || echo 0)
      latest=$(sudo -u "$U" git -C "$REPO" show @{u}:files/plexpied.py 2>/dev/null | sed -n 's/^VERSION = "\(.*\)"/\1/p' | head -1)
      changes=$(sudo -u "$U" git -C "$REPO" log --format=%s HEAD..@{u} 2>/dev/null | head -6 | \
        python3 -c 'import json,sys; print(json.dumps([l.strip()[:90] for l in sys.stdin if l.strip()]))')
    fi
    printf '{"checked":%s,"behind":%s,"latest":"%s","changes":%s}\n' "$(date +%s)" "${behind:-0}" \
      "$(printf %s "$latest" | tr -cd '0-9A-Za-z.+-')" "${changes:-[]}" > "$STATE/plexpie.json.tmp"
    mv -f "$STATE/plexpie.json.tmp" "$STATE/plexpie.json"
    cat "$STATE/plexpie.json" ;;
  check-os)         # how many Raspberry Pi OS packages can be updated? (refreshes the package list)
    apt-get update -qq >/dev/null 2>&1
    pk=$(apt-get -s -o Debug::NoLocking=1 full-upgrade 2>/dev/null | awk '/^Inst /{print $2}')
    n=$(printf '%s\n' "$pk" | grep -c .)
    names=$(printf '%s\n' "$pk" | head -8 | python3 -c 'import json,sys; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))')
    reboot=false; [ -f /var/run/reboot-required ] && reboot=true
    printf '{"checked":%s,"count":%s,"packages":%s,"reboot":%s}\n' "$(date +%s)" "$n" "${names:-[]}" "$reboot" \
      > "$STATE/os.json.tmp"
    mv -f "$STATE/os.json.tmp" "$STATE/os.json"
    cat "$STATE/os.json" ;;
  update-check) "$0" check-plexpie >/dev/null; "$0" check-os >/dev/null ;;
  update-run)       # update-run plexpie|os|all, in its own unit so it survives PlexPie restarting
    kind=${2:-all}
    [[ "$kind" =~ ^(plexpie|os|all)$ ]] || { echo "usage: update-run plexpie|os|all" >&2; exit 2; }
    protect_active && { echo "Power-cut protection is on: turn it off to install updates" >&2; exit 3; }
    systemctl is-active --quiet plexpie-update && { echo "already running"; exit 0; }
    systemctl reset-failed plexpie-update 2>/dev/null
    systemd-run --quiet --unit=plexpie-update --collect /opt/plexpie/plexpie-admin update-do "$kind" ;;
  update-do)
    kind=${2:-all}
    exec >>"$LOG" 2>&1
    echo "=== $kind update started $(date)"
    date +%s > "$STATE/update-started"
    echo "$kind" > "$STATE/update-kind"
    export DEBIAN_FRONTEND=noninteractive
    if [ "$kind" != plexpie ]; then
      KIND=os; [ "$kind" = all ] && span=60 || span=100     # "all" = OS first (0-60%), then PlexPie (60-100%)
      json_status "Refreshing the list of updates" true ',"percent":1'
      apt-get update -q -o APT::Status-Fd=3 3> >(apt_progress 1 $((span * 10 / 100)) "Refreshing the list of updates")
      wait_reader
      lo=$((span * 10 / 100)); hi=$((span * 92 / 100))
      json_status "Preparing" true ",\"percent\":$lo"
      apt-get -y -q -o APT::Status-Fd=3 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
        full-upgrade 3> >(apt_progress "$lo" $((hi - lo)))
      rc=$?
      wait_reader
      [ $rc -eq 0 ] || { json_status "Raspberry Pi OS update failed (see $LOG)" false; exit 1; }
      json_status "Cleaning up" true ",\"percent\":$((span * 96 / 100))"
      apt-get -y -q autoremove
      "$0" check-os >/dev/null
    fi
    if [ "$kind" != os ] && [ -d "$REPO/.git" ]; then
      KIND=plexpie; [ "$kind" = all ] && base=60 || base=0; span=$((100 - base))
      json_status "Downloading PlexPie" true ",\"percent\":$((base + span * 3 / 100))"
      { sudo -u "$U" git -C "$REPO" fetch -q && sudo -u "$U" git -C "$REPO" reset -q --hard @{u}; } || \
        { json_status "PlexPie download failed (see $LOG)" false; exit 1; }   # an appliance copy: always match GitHub
      total=$(grep -c '^step "' "$REPO/install.sh"); [ "$total" -gt 0 ] || total=10
      json_status "Installing PlexPie" true ",\"percent\":$((base + span * 8 / 100))"
      i=0
      bash "$REPO/install.sh" --no-restart-ui </dev/null 2>&1 | while IFS= read -r line; do
        printf '%s\n' "$line"
        case "$line" in
          "==> "*) i=$((i + 1)); p=$((base + span * 8 / 100 + i * span * 88 / 100 / total))
            json_status "Installing PlexPie" true ",\"percent\":$p,\"detail\":\"$(printf %s "${line#==> }" | tr -cd 'A-Za-z0-9 ._+()-' | cut -c1-48)\"" ;;
        esac
      done
      [ "${PIPESTATUS[0]}" -eq 0 ] || { json_status "PlexPie install failed (see $LOG)" false; exit 1; }
      "$0" check-plexpie >/dev/null
    fi
    reboot=false; [ -f /var/run/reboot-required ] && reboot=true
    json_status "Up to date" false ",\"percent\":100,\"reboot\":$reboot"
    echo "=== $kind update finished $(date)" ;;
  apply-run)        # reinstall with the current plexpie.conf (after restoring a backup)
    systemctl is-active --quiet plexpie-update && { echo "an update is running, try again in a few minutes" >&2; exit 1; }
    systemctl reset-failed plexpie-update 2>/dev/null
    label=$(printf '%s' "${2:-Applying restored settings}" | tr -cd 'A-Za-z0-9 ._-' | cut -c1-40)
    systemd-run --quiet --unit=plexpie-update --collect /opt/plexpie/plexpie-admin apply-do "$label" ;;
  apply-do)
    exec >>"$LOG" 2>&1
    label=${2:-Applying restored settings}
    echo "=== $label started $(date)"
    date +%s > "$STATE/update-started"
    json_status "$label" true ',"percent":20'
    bash "$REPO/install.sh" --no-restart-ui </dev/null || { json_status "$label failed (see $LOG)" false; exit 1; }
    json_status "Done" false ',"percent":100'
    pkill -u "$U" -f plexpie-chromium || true   # reload the screen with the new settings
    echo "=== $label finished $(date)" ;;
  plexamp-claim)    # plexamp-claim CODE NAME: link Plexamp to a Plex account (the setup wizard's claim step)
    [[ "${2:-}" =~ ^claim-[A-Za-z0-9_-]{6,}$ ]] || { echo "bad claim code" >&2; exit 2; }
    name=$(printf '%s' "${3:-PlexPie}" | tr -cd "A-Za-z0-9 ._'-" | cut -c1-40)
    systemctl reset-failed plexpie-claim 2>/dev/null
    systemd-run --quiet --unit=plexpie-claim --collect /opt/plexpie/plexpie-admin plexamp-claim-do "$2" "${name:-PlexPie}" ;;
  plexamp-claim-do)
    UHOME=$(getent passwd "$U" | cut -d: -f6)
    TOKEN="$UHOME/.local/share/Plexamp/Settings/%40Plexamp%3Auser%3Atoken"
    echo '{"state":"linking"}' > "$STATE/claim.json"
    systemctl stop plexamp 2>/dev/null || true
    # Plexamp asks for the claim code, then the player name, the same as in a terminal
    ( printf '%s\n' "$2"; sleep 10; printf '%s\n' "$3"; sleep 200 ) | \
      timeout 180 sudo -u "$U" HOME="$UHOME" node /opt/plexamp/js/index.js >/dev/null 2>&1 &
    feeder=$!
    for _ in $(seq 150); do [ -s "$TOKEN" ] && break; sleep 1; done
    [ -s "$TOKEN" ] && sleep 15                  # let it save the player name too
    kill "$feeder" 2>/dev/null; pkill -u "$U" -f '/opt/plexamp/js/index.js' 2>/dev/null; sleep 1
    systemctl start plexamp
    if [ -s "$TOKEN" ]; then echo '{"state":"linked"}' > "$STATE/claim.json"
    else echo '{"state":"failed"}' > "$STATE/claim.json"; fi ;;
  protect-status)
    avail=false; command -v raspi-config >/dev/null && avail=true
    active=false; protect_active && active=true
    printf '{"available":%s,"active":%s}\n' "$avail" "$active" ;;
  protect-on|protect-off)
    command -v raspi-config >/dev/null || { echo "raspi-config is not installed" >&2; exit 2; }
    [ "$1" = protect-on ] && v=0 || v=1          # raspi-config: 0 = enable
    raspi-config nonint do_overlayfs "$v" ;;     # takes effect after a reboot
  bt-pair)          # open pairing for two minutes (the helper makes the Pi discoverable)
    install -d -m 755 /run/plexpie
    echo $(( $(date +%s) + ${2:-120} )) > /run/plexpie/bt-pair-until ;;
  bt-stop) rm -f /run/plexpie/bt-pair-until ;;
  bt-forget)
    [[ "${2:-}" =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]] || { echo "bad address" >&2; exit 2; }
    bluetoothctl remove "$2" ;;
  bt-pause)         # pause the phone that's playing (AVRCP), or disconnect it if it can't be paused
    python3 - <<'PY'
import dbus
bus = dbus.SystemBus()
objs = dbus.Interface(bus.get_object("org.bluez", "/"), "org.freedesktop.DBus.ObjectManager").GetManagedObjects()
done = False
for path, ifaces in objs.items():
    if "org.bluez.MediaPlayer1" in ifaces:
        try:
            dbus.Interface(bus.get_object("org.bluez", path), "org.bluez.MediaPlayer1").Pause(); done = True
        except dbus.DBusException:
            pass
if not done:
    for path, ifaces in objs.items():
        d = ifaces.get("org.bluez.Device1")
        if d and d.get("Connected"):
            dbus.Interface(bus.get_object("org.bluez", path), "org.bluez.Device1").Disconnect()
PY
    ;;
  exit-screen)      # exit-screen desktop|console: leave the PlexPie screen until the next restart
    want=${2:-desktop}
    systemctl cat "$DM.service" >/dev/null 2>&1 || want=console       # no desktop installed (e.g. Raspberry Pi OS Lite)
    install -d -m 755 /run/plexpie
    echo "$want" > /run/plexpie/paused          # in /run, so a restart always comes back to PlexPie
    systemd-run --quiet --collect --unit="plexpie-exit-$(date +%s)" /opt/plexpie/plexpie-admin exit-do "$want" ;;
  exit-do)
    if [ "$2" = desktop ]; then
      UHOME=$(getent passwd "$U" | cut -d: -f6)
      if [ -d "$UHOME/Desktop" ] || install -d -o "$U" -g "$U" "$UHOME/Desktop"; then
        install -o "$U" -g "$U" -m 755 /usr/share/applications/plexpie-back.desktop "$UHOME/Desktop/" 2>/dev/null || true
      fi
    fi
    for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do   # end the screen session on tty1
      [ "$(loginctl show-session "$s" -p TTY --value 2>/dev/null)" = tty1 ] && loginctl terminate-session "$s"
    done
    sleep 2
    [ "$2" = desktop ] && systemctl start "$DM.service"
    true ;;
  resume)           # back to the PlexPie screen (the "Back to PlexPie" icon, or typing: plexpie)
    rm -f /run/plexpie/paused
    systemd-run --quiet --collect --unit="plexpie-resume-$(date +%s)" /opt/plexpie/plexpie-admin resume-do ;;
  resume-do)
    systemctl stop "$DM.service" 2>/dev/null || true
    chvt 1 2>/dev/null || true
    for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
      [ "$(loginctl show-session "$s" -p TTY --value 2>/dev/null)" = tty1 ] && loginctl terminate-session "$s"
    done
    systemctl restart getty@tty1.service ;;   # autologin starts the PlexPie screen again
  boot-look)        # boot-look on|off: PlexPie start-up screen instead of boot text (after a restart)
    want=${2:-on}
    CFG=/boot/firmware/config.txt; [ -f "$CFG" ] || CFG=/boot/config.txt
    UHOME=$(getent passwd "$U" | cut -d: -f6)
    QUIET="quiet splash loglevel=3 logo.nologo vt.global_cursor_default=0 plymouth.ignore-serial-consoles"
    [ -n "$BOOTKIND" ] || { echo "no boot options file (cmdline.txt or GRUB) found"; exit 0; }
    line=$(boot_line_get)
    # Remember what the machine had before PlexPie touched it, so "off" puts exactly that back.
    [ -f "$STATE/cmdline-orig" ] || printf '%s\n' "$line" > "$STATE/cmdline-orig"
    orig=" $(cat "$STATE/cmdline-orig") "
    new=" $line "
    if [ "$want" = on ]; then
      for t in $QUIET; do [[ "$new" == *" $t "* ]] || new="$new$t "; done
      new=${new// console=tty1 / console=tty3 }          # boot messages to a hidden console
      if [ "$BOOTKIND" = pi ]; then
        grep -q '^disable_splash=1' "$CFG" 2>/dev/null || echo 'disable_splash=1' >> "$CFG"   # no rainbow square
      else
        grub_set GRUB_TIMEOUT_STYLE hidden; grub_set GRUB_TIMEOUT 0      # straight to PlexPie (hold Shift for the menu)
      fi
      plymouth_theme
      mkdir -p /etc/systemd/system/getty@tty1.service.d
      printf '[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin %s --noclear --noissue --nonewline --skip-login %%I $TERM\n' "$U" \
        > /etc/systemd/system/getty@tty1.service.d/zz-plexpie-quiet.conf
      [ -n "$UHOME" ] && install -o "$U" -g "$U" -m 644 /dev/null "$UHOME/.hushlogin"
    else
      for t in $QUIET; do [[ "$orig" == *" $t "* ]] || new=${new// $t / }; done
      [[ "$orig" == *" console=tty1 "* ]] && new=${new// console=tty3 / console=tty1 }
      if [ "$BOOTKIND" = pi ]; then sed -i '/^disable_splash=1$/d' "$CFG" 2>/dev/null || true; else grub_restore; fi
      rm -f /etc/systemd/system/getty@tty1.service.d/zz-plexpie-quiet.conf
      [ -n "$UHOME" ] && rm -f "$UHOME/.hushlogin"
    fi
    systemctl daemon-reload
    new=$(echo $new)                                     # tidy spaces
    if [ "$new" != "$line" ]; then boot_line_set "$new"
    elif [ "$BOOTKIND" = grub ]; then grub_update; fi
    echo "$want" > "$STATE/boot-look"
    echo "boot look: $want (after a restart)" ;;
  boot-look-bg)     # same, in the background (rebuilding the start-up files takes a minute)
    systemd-run --quiet --collect --unit="plexpie-bootlook-$(date +%s)" /opt/plexpie/plexpie-admin boot-look "${2:-on}" ;;
  console-rotation) # console-rotation 0|90|180|270: turn the text console like the screen (after a restart)
    deg=${2:-0}
    case "$deg" in 0|90|180|270) ;; *) echo "bad rotation" >&2; exit 2 ;; esac
    [ -n "$BOOTKIND" ] || { echo "no boot options file"; exit 0; }
    line=$(boot_line_get)
    if grep -q 'video=[^ ]*rotate=' <<<"$line"; then
      echo "kept: rotate= set by hand in the boot options"; exit 0
    fi
    new=$(sed -E 's/[[:space:]]*fbcon=rotate:[0-3]//g' <<<"$line")
    [ "$deg" != 0 ] && new="$new fbcon=rotate:$((deg / 90))"
    new=$(echo $new)
    if [ "$new" != "$line" ]; then
      boot_line_set "$new"
      echo "changed (after a restart)"
    fi ;;
  # ---- Tailscale: reach this player from anywhere, from the user's own devices only.
  # PlexPie never turns on Tailscale SSH, subnet routes, exit nodes, Funnel or "tailscale serve"
  # (serve would make every visitor look like the screen itself, which needs no PIN).
  # A Tailscale that was set up before PlexPie installed it is left alone: status only.
  tailscale-status)
    installed=false; command -v tailscale >/dev/null && installed=true
    owned=false; [ -f "$STATE/tailscale-owned" ] && owned=true
    installing=false; [ -f "$STATE/tailscale-installing" ] && systemctl is-active --quiet plexpie-tailscale && installing=true
    err=$(cat "$STATE/tailscale-error" 2>/dev/null | tr -cd 'A-Za-z0-9 .,:/()_-' | cut -c1-120)
    st='{}'; $installed && st=$(timeout 5 tailscale status --json 2>/dev/null || echo '{}')
    TS_INSTALLED=$installed TS_OWNED=$owned TS_INSTALLING=$installing TS_ERR=$err python3 -c '
import json, os, sys
try:
    s = json.loads(sys.stdin.read() or "{}")
except ValueError:
    s = {}
me = s.get("Self") or {}
ips = [a for a in me.get("TailscaleIPs") or [] if "." in a]
url = s.get("AuthURL") or ""
print(json.dumps({"installed": os.environ["TS_INSTALLED"] == "true", "owned": os.environ["TS_OWNED"] == "true",
                  "installing": os.environ["TS_INSTALLING"] == "true", "error": os.environ.get("TS_ERR", ""),
                  "state": s.get("BackendState") or ("" if os.environ["TS_INSTALLED"] == "true" else "NotInstalled"),
                  "auth_url": url if url.startswith("https://login.tailscale.com/") else "",
                  "dns": (me.get("DNSName") or "").rstrip("."), "ip": ips[0] if ips else ""}))' <<<"$st" ;;
  tailscale-install)   # install from Tailscale's own repository, then sign-in starts (in the background)
    systemctl is-active --quiet plexpie-tailscale && exit 0
    systemctl reset-failed plexpie-tailscale 2>/dev/null
    systemd-run --quiet --unit=plexpie-tailscale --collect /opt/plexpie/plexpie-admin tailscale-install-do "${2:-}" ;;
  tailscale-install-do)  # tailscale-install-do [NAME]: NAME given = start sign-in afterwards
    rm -f "$STATE/tailscale-error"
    if ! command -v tailscale >/dev/null; then
      touch "$STATE/tailscale-installing"; trap 'rm -f "$STATE/tailscale-installing"' EXIT
      . /etc/os-release 2>/dev/null
      case "${ID:-}" in
        ubuntu) dist="ubuntu/${VERSION_CODENAME:-}" ;;
        raspbian) dist="raspbian/${VERSION_CODENAME:-}" ;;
        *) dist="debian/${VERSION_CODENAME:-}" ;;
      esac
      base="https://pkgs.tailscale.com/stable/$dist"
      if ! { mkdir -p -m 0755 /usr/share/keyrings &&
             curl -fsSL "$base.noarmor.gpg" -o /usr/share/keyrings/tailscale-archive-keyring.gpg &&
             curl -fsSL "$base.tailscale-keyring.list" -o /etc/apt/sources.list.d/tailscale.list &&
             apt-get update -q >>"$LOG" 2>&1 && DEBIAN_FRONTEND=noninteractive apt-get install -y -q tailscale >>"$LOG" 2>&1; }; then
        rm -f /etc/apt/sources.list.d/tailscale.list
        echo "Couldn't install Tailscale for ${PRETTY_NAME:-this system} (see $LOG)" > "$STATE/tailscale-error"
        exit 1
      fi
      touch "$STATE/tailscale-owned"
      rm -f "$STATE/tailscale-installing"
    fi
    [ -f "$STATE/tailscale-owned" ] || exit 0
    systemctl enable --now tailscaled >/dev/null 2>&1
    [ -n "${2:-}" ] && exec "$0" tailscale-up-do "$2"
    exit 0 ;;
  tailscale-up)        # tailscale-up NAME: connect; shows a sign-in link the first time
    [ -f "$STATE/tailscale-owned" ] || { echo "Tailscale is managed outside PlexPie" >&2; exit 1; }
    systemctl is-active --quiet plexpie-tailscale && exit 0
    systemctl reset-failed plexpie-tailscale 2>/dev/null
    systemd-run --quiet --unit=plexpie-tailscale --collect /opt/plexpie/plexpie-admin tailscale-up-do "${2:-plexpie}" ;;
  tailscale-up-do)
    [ -f "$STATE/tailscale-owned" ] || exit 1
    name=$(printf '%s' "${2:-plexpie}" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9\n' '-' | sed 's/--*/-/g; s/^-//; s/-$//' | cut -c1-40)
    systemctl enable --now tailscaled >/dev/null 2>&1
    rm -f "$STATE/tailscale-error"
    # Waits until someone signs in from the link (the Settings page shows it), at most 15 minutes.
    timeout 900 tailscale up --reset --hostname="${name:-plexpie}" --accept-dns=false --accept-routes=false >/dev/null 2>&1
    rc=$?
    [ $rc = 0 ] || [ $rc = 124 ] || echo "Tailscale couldn't connect (code $rc)" > "$STATE/tailscale-error"
    exit 0 ;;
  tailscale-down)      # stay signed in, just disconnect
    [ -f "$STATE/tailscale-owned" ] || exit 1
    systemctl stop plexpie-tailscale 2>/dev/null
    tailscale down 2>/dev/null; exit 0 ;;
  tailscale-logout)    # sign out: this player leaves your Tailscale network
    [ -f "$STATE/tailscale-owned" ] || exit 1
    systemctl stop plexpie-tailscale 2>/dev/null
    tailscale logout 2>/dev/null; exit 0 ;;
  update-status)
    # A restart or power cut in the middle of an update leaves "running" behind: clear it.
    if grep -q '"running":true' "$STATE/update-run.json" 2>/dev/null && ! systemctl is-active --quiet plexpie-update; then
      json_status "The last update was interrupted. Tap Update to finish it" false
    fi
    cat "$STATE/plexpie.json" 2>/dev/null || echo '{}'
    cat "$STATE/os.json" 2>/dev/null || echo '{}'
    cat "$STATE/update-run.json" 2>/dev/null || echo '{}' ;;
  *) echo "usage: plexpie-admin wifi-status|wifi-on|wifi-off|wifi-scan|wifi-connect SSID|check-plexpie|check-os|update-check|update-run plexpie/os/all|update-status|apply-run|protect-status|protect-on|protect-off|tailscale-status|tailscale-install|tailscale-up NAME|tailscale-down|tailscale-logout" >&2
     exit 2 ;;
esac
