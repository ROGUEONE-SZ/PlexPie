#!/bin/bash
# PlexPie admin helper: the only root actions the Settings page can trigger.
# Called by the plexpie daemon through sudo (see /etc/sudoers.d/plexpie).
set -uo pipefail
STATE=/var/lib/plexpie
LOG=/var/log/plexpie-update.log
REPO=$(cat /etc/plexpie/repo_dir 2>/dev/null || true)
U=$(stat -c %U "$REPO" 2>/dev/null || echo root)
mkdir -p "$STATE"

json_status() {   # step running(true/false) [extra json]
  printf '{"step":"%s","running":%s,"time":%s,"started":%s,"kind":"%s"%s}\n' "$1" "$2" "$(date +%s)" \
    "$(cat "$STATE/update-started" 2>/dev/null || echo 0)" "${KIND:-$(cat "$STATE/update-kind" 2>/dev/null)}" \
    "${3:-}" > "$STATE/update-run.json.tmp"
  mv -f "$STATE/update-run.json.tmp" "$STATE/update-run.json"
}

apt_progress() {  # reads apt's Status-Fd and reports an overall percent between $1 and $1+$2
  local base=$1 span=$2 fixed=${3:-} last=-1 kind pkg pct msg lab b sp p
  while IFS=: read -r kind pkg pct msg; do
    case "$kind" in
      dlstatus) lab="Downloading updates"; b=$base; sp=$((span * 3 / 10)) ;;
      pmstatus) lab="Installing updates"; b=$((base + span * 3 / 10)); sp=$((span * 7 / 10)) ;;
      *) continue ;;
    esac
    [ -n "$fixed" ] && { lab=$fixed; b=$base; sp=$span; }
    pct=${pct%%.*}; [[ "$pct" =~ ^[0-9]+$ ]] || pct=0
    p=$((b + pct * sp / 100))
    [ "$p" = "$last" ] && continue
    last=$p
    json_status "$lab" true ",\"percent\":$p,\"detail\":\"$(printf %s "$pkg" | tr -cd 'A-Za-z0-9._+-' | cut -c1-40)\""
  done
}

protect_active() { grep -Eq 'boot=overlay|overlayroot=tmpfs' /proc/cmdline; }

case "${1:-}" in
  wifi-status)
    radio=$(nmcli -t -f WIFI g 2>/dev/null || echo unknown)
    ssid=$(nmcli -t -f ACTIVE,SSID dev wifi 2>/dev/null | awk -F: '$1=="yes"{print $2; exit}')
    ip=$(ip -4 -o addr show wlan0 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
    eth=$(ip -4 -o addr show eth0 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
    python3 -c 'import json,sys; print(json.dumps(dict(zip(["radio","ssid","ip","eth_ip"], sys.argv[1:]))))' \
      "$radio" "$ssid" "$ip" "$eth" ;;
  wifi-on)  nmcli radio wifi on ;;
  wifi-off) nmcli radio wifi off ;;
  wifi-scan)
    nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY dev wifi list --rescan yes 2>/dev/null | python3 -c '
import json, sys
seen = {}
for line in sys.stdin:
    parts = line.rstrip("\n").replace("\\:", "\x00").split(":")
    if len(parts) < 4 or not parts[1]:
        continue
    use, ssid, sig, sec = [p.replace("\x00", ":") for p in parts[:4]]
    if ssid not in seen or int(sig or 0) > seen[ssid]["signal"]:
        seen[ssid] = {"ssid": ssid, "signal": int(sig or 0), "secure": sec not in ("", "--"), "active": use == "*"}
print(json.dumps(sorted(seen.values(), key=lambda n: -n["signal"])[:20]))' ;;
  wifi-connect)
    ssid=${2:-}
    [ -n "$ssid" ] && [ ${#ssid} -le 32 ] && [[ "$ssid" != *$'\n'* ]] || { echo "bad network name" >&2; exit 2; }
    IFS= read -r pw || true          # password arrives on stdin, never on the command line
    name="plexpie-$(printf '%s' "$ssid" | tr -c 'A-Za-z0-9._-' '_')"
    f="/etc/NetworkManager/system-connections/$name.nmconnection"
    umask 077
    {
      printf '[connection]\nid=%s\ntype=wifi\ninterface-name=wlan0\nautoconnect=true\n\n' "$name"
      printf '[wifi]\nmode=infrastructure\nssid=%s\n\n' "$ssid"
      [ -n "$pw" ] && printf '[wifi-security]\nkey-mgmt=wpa-psk\npsk=%s\n\n' "$pw"
      printf '[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n'
    } > "$f"
    chmod 600 "$f"
    nmcli radio wifi on
    nmcli connection reload
    nmcli connection up id "$name" ;;
  check-plexpie)    # is there a newer PlexPie on GitHub? (quick: one git fetch)
    behind=0; latest=""; changes="[]"
    if [ -d "$REPO/.git" ]; then
      sudo -u "$U" git -C "$REPO" fetch -q 2>/dev/null
      behind=$(sudo -u "$U" git -C "$REPO" rev-list --count HEAD..@{u} 2>/dev/null || echo 0)
      latest=$(sudo -u "$U" git -C "$REPO" show @{u}:files/plexpied.py 2>/dev/null | sed -n 's/^VERSION = "\(.*\)"/\1/p' | head -1)
      changes=$(sudo -u "$U" git -C "$REPO" log --format=%s HEAD..@{u} 2>/dev/null | head -6 | \
        python3 -c 'import json,sys; print(json.dumps([l.strip()[:90] for l in sys.stdin if l.strip()]))')
    fi
    printf '{"checked":%s,"behind":%s,"latest":"%s","changes":%s}\n' "$(date +%s)" "${behind:-0}" \
      "$(printf %s "$latest" | tr -cd '0-9A-Za-z.+-')" "${changes:-[]}" > "$STATE/plexpie.json.tmp"
    mv -f "$STATE/plexpie.json.tmp" "$STATE/plexpie.json"
    cat "$STATE/plexpie.json" ;;
  check-os)         # how many Raspberry Pi OS packages can be updated? (refreshes the package list)
    apt-get update -qq >/dev/null 2>&1
    pk=$(apt-get -s -o Debug::NoLocking=1 upgrade 2>/dev/null | awk '/^Inst /{print $2}')
    n=$(printf '%s\n' "$pk" | grep -c .)
    names=$(printf '%s\n' "$pk" | head -8 | python3 -c 'import json,sys; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))')
    reboot=false; [ -f /var/run/reboot-required ] && reboot=true
    printf '{"checked":%s,"count":%s,"packages":%s,"reboot":%s}\n' "$(date +%s)" "$n" "${names:-[]}" "$reboot" \
      > "$STATE/os.json.tmp"
    mv -f "$STATE/os.json.tmp" "$STATE/os.json"
    cat "$STATE/os.json" ;;
  update-check) "$0" check-plexpie >/dev/null; "$0" check-os >/dev/null ;;
  update-run)       # update-run plexpie|os|all, in its own unit so it survives PlexPie restarting
    kind=${2:-all}
    [[ "$kind" =~ ^(plexpie|os|all)$ ]] || { echo "usage: update-run plexpie|os|all" >&2; exit 2; }
    protect_active && { echo "Power-cut protection is on: turn it off to install updates" >&2; exit 3; }
    systemctl is-active --quiet plexpie-update && { echo "already running"; exit 0; }
    systemctl reset-failed plexpie-update 2>/dev/null
    systemd-run --quiet --unit=plexpie-update --collect /opt/plexpie/plexpie-admin update-do "$kind" ;;
  update-do)
    kind=${2:-all}
    exec >>"$LOG" 2>&1
    echo "=== $kind update started $(date)"
    date +%s > "$STATE/update-started"
    echo "$kind" > "$STATE/update-kind"
    export DEBIAN_FRONTEND=noninteractive
    if [ "$kind" != plexpie ]; then
      KIND=os; [ "$kind" = all ] && span=60 || span=100     # "all" = OS first (0-60%), then PlexPie (60-100%)
      json_status "Refreshing the list of updates" true ',"percent":1'
      apt-get update -q -o APT::Status-Fd=3 3> >(apt_progress 1 $((span * 10 / 100)) "Refreshing the list of updates")
      wait $! 2>/dev/null
      lo=$((span * 10 / 100)); hi=$((span * 92 / 100))
      json_status "Preparing" true ",\"percent\":$lo"
      apt-get -y -q -o APT::Status-Fd=3 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold \
        upgrade 3> >(apt_progress "$lo" $((hi - lo)))
      rc=$?
      wait $! 2>/dev/null                       # let the progress reader finish writing
      [ $rc -eq 0 ] || { json_status "Raspberry Pi OS update failed (see $LOG)" false; exit 1; }
      json_status "Cleaning up" true ",\"percent\":$((span * 96 / 100))"
      apt-get -y -q autoremove
      "$0" check-os >/dev/null
    fi
    if [ "$kind" != os ] && [ -d "$REPO/.git" ]; then
      KIND=plexpie; [ "$kind" = all ] && base=60 || base=0; span=$((100 - base))
      json_status "Downloading PlexPie" true ",\"percent\":$((base + span * 3 / 100))"
      { sudo -u "$U" git -C "$REPO" fetch -q && sudo -u "$U" git -C "$REPO" reset -q --hard @{u}; } || \
        { json_status "PlexPie download failed (see $LOG)" false; exit 1; }   # an appliance copy: always match GitHub
      total=$(grep -c '^step "' "$REPO/install.sh"); [ "$total" -gt 0 ] || total=10
      json_status "Installing PlexPie" true ",\"percent\":$((base + span * 8 / 100))"
      i=0
      bash "$REPO/install.sh" --no-restart-ui </dev/null 2>&1 | while IFS= read -r line; do
        printf '%s\n' "$line"
        case "$line" in
          "==> "*) i=$((i + 1)); p=$((base + span * 8 / 100 + i * span * 88 / 100 / total))
            json_status "Installing PlexPie" true ",\"percent\":$p,\"detail\":\"$(printf %s "${line#==> }" | tr -cd 'A-Za-z0-9 ._+()-' | cut -c1-48)\"" ;;
        esac
      done
      [ "${PIPESTATUS[0]}" -eq 0 ] || { json_status "PlexPie install failed (see $LOG)" false; exit 1; }
      "$0" check-plexpie >/dev/null
    fi
    reboot=false; [ -f /var/run/reboot-required ] && reboot=true
    json_status "Up to date" false ",\"percent\":100,\"reboot\":$reboot"
    echo "=== $kind update finished $(date)" ;;
  apply-run)        # reinstall with the current plexpie.conf (after restoring a backup)
    systemctl is-active --quiet plexpie-update && { echo "an update is running, try again in a few minutes" >&2; exit 1; }
    systemctl reset-failed plexpie-update 2>/dev/null
    systemd-run --quiet --unit=plexpie-update --collect /opt/plexpie/plexpie-admin apply-do ;;
  apply-do)
    exec >>"$LOG" 2>&1
    echo "=== restore started $(date)"
    date +%s > "$STATE/update-started"
    json_status "Applying restored settings" true ',"percent":20'
    bash "$REPO/install.sh" --no-restart-ui </dev/null || { json_status "Restore failed (see $LOG)" false; exit 1; }
    json_status "Settings restored" false ',"percent":100'
    pkill -u "$U" -f plexpie-chromium || true   # reload the screen with the restored settings
    echo "=== restore finished $(date)" ;;
  protect-status)
    avail=false; command -v raspi-config >/dev/null && avail=true
    active=false; protect_active && active=true
    printf '{"available":%s,"active":%s}\n' "$avail" "$active" ;;
  protect-on|protect-off)
    command -v raspi-config >/dev/null || { echo "raspi-config is not installed" >&2; exit 2; }
    [ "$1" = protect-on ] && v=0 || v=1          # raspi-config: 0 = enable
    raspi-config nonint do_overlayfs "$v" ;;     # takes effect after a reboot
  bt-pair)          # open pairing for two minutes (the helper makes the Pi discoverable)
    install -d -m 755 /run/plexpie
    echo $(( $(date +%s) + ${2:-120} )) > /run/plexpie/bt-pair-until ;;
  bt-stop) rm -f /run/plexpie/bt-pair-until ;;
  bt-forget)
    [[ "${2:-}" =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]] || { echo "bad address" >&2; exit 2; }
    bluetoothctl remove "$2" ;;
  bt-pause)         # pause the phone that's playing (AVRCP), or disconnect it if it can't be paused
    python3 - <<'PY'
import dbus
bus = dbus.SystemBus()
objs = dbus.Interface(bus.get_object("org.bluez", "/"), "org.freedesktop.DBus.ObjectManager").GetManagedObjects()
done = False
for path, ifaces in objs.items():
    if "org.bluez.MediaPlayer1" in ifaces:
        try:
            dbus.Interface(bus.get_object("org.bluez", path), "org.bluez.MediaPlayer1").Pause(); done = True
        except dbus.DBusException:
            pass
if not done:
    for path, ifaces in objs.items():
        d = ifaces.get("org.bluez.Device1")
        if d and d.get("Connected"):
            dbus.Interface(bus.get_object("org.bluez", path), "org.bluez.Device1").Disconnect()
PY
    ;;
  update-status)
    # A restart or power cut in the middle of an update leaves "running" behind: clear it.
    if grep -q '"running":true' "$STATE/update-run.json" 2>/dev/null && ! systemctl is-active --quiet plexpie-update; then
      json_status "The last update was interrupted. Tap Update to finish it" false
    fi
    cat "$STATE/plexpie.json" 2>/dev/null || echo '{}'
    cat "$STATE/os.json" 2>/dev/null || echo '{}'
    cat "$STATE/update-run.json" 2>/dev/null || echo '{}' ;;
  *) echo "usage: plexpie-admin wifi-status|wifi-on|wifi-off|wifi-scan|wifi-connect SSID|check-plexpie|check-os|update-check|update-run plexpie/os/all|update-status|apply-run|protect-status|protect-on|protect-off" >&2
     exit 2 ;;
esac
