#!/bin/bash
# PlexPie X session (started from ~/.xinitrc on tty1 autologin).
# Keeps the overlay and the Chromium kiosk running; the plexpie daemon
# decides which app is on screen.

CONF=/etc/plexpie/plexpie.conf
[ -r "$CONF" ] && . "$CONF"

# Which browser runs the screen (written by the installer: Chromium on a Pi, Google Chrome on a PC)
BROWSER=chromium; BROWSER_PROFILE=".config/plexpie-chromium"
[ -r /etc/plexpie/platform ] && . /etc/plexpie/platform
command -v "$BROWSER" >/dev/null || BROWSER=$(command -v chromium || command -v chromium-browser || command -v google-chrome-stable || echo chromium)

export DISPLAY="${DISPLAY:-:0}"
PROFILE="$HOME/$BROWSER_PROFILE"
LAUNCHER="http://127.0.0.1:8080/"
SCALE="${CHROMIUM_SCALE:-1}"

log() { echo "$(date '+%F %T') $*"; }
x_alive() { xset q >/dev/null 2>&1; }

# PlexPie controls the backlight itself; X must not blank or power down.
xset s off
xset s noblank
xset -dpms
xsetroot -solid "#0b0b0f" 2>/dev/null     # dark, like the start-up logo, until the launcher shows

# Screen rotation (Settings > Screen > Rotation; "auto" follows the Raspberry Pi desktop's setting).
# The touchscreen is turned to match, so taps land where you touch.
apply_rotation() {
  local out deg want cur id
  out=$(xrandr --query 2>/dev/null | awk '$2=="connected"{print $1}' | grep -m1 '^DSI')
  [ -n "$out" ] || out=$(xrandr --query 2>/dev/null | awk '$2=="connected"{print $1; exit}')
  [ -n "$out" ] || return 0
  deg=$(python3 /opt/plexpie/plexpie-rotation "$out" 2>/dev/null || echo 0)
  case "$deg" in 90) want=right ;; 180) want=inverted ;; 270) want=left ;; *) want=normal; deg=0 ;; esac
  cur=$(xrandr --query 2>/dev/null | awk -v o="$out" '$1==o{r="normal"; for(i=3;i<=NF;i++){if($i ~ /^\(/) break; if($i ~ /^(left|right|inverted)$/) r=$i}; print r}')
  if [ "$cur" != "$want" ]; then
    log "rotating $out: $cur -> $want"
    xrandr --output "$out" --rotate "$want" || log "could not rotate $out"
  fi
  if command -v xinput >/dev/null; then
    for id in $(xinput list --id-only 2>/dev/null); do
      xinput list-props "$id" 2>/dev/null | grep -q "libinput Calibration Matrix" && xinput map-to-output "$id" "$out" 2>/dev/null
    done
  fi
  mkdir -p "$HOME/.cache"
  echo "$deg" > "$HOME/.cache/plexpie-rotation"
}
apply_rotation

# Pointer: hidden while you use the touchscreen, shown when a mouse moves.
if command -v unclutter >/dev/null; then
  ( unclutter --timeout 3 --jitter 4 --hide-on-touch --start-hidden 2>/dev/null || unclutter --timeout 1 ) &
fi

# Overlay (Home button + wake shield), restarted if it ever exits.
(
  while x_alive; do
    apply_rotation
    python3 /opt/plexpie/plexpie-overlay.py
    log "overlay exited ($?), restarting"
    sleep 2
  done
) &

log "waiting for the plexpie daemon"
until curl -fs --max-time 1 "${LAUNCHER}api/state" >/dev/null; do x_alive || exit 0; sleep 0.5; done

while x_alive; do
  # Mark the last run as a clean exit so Chromium never shows "Restore pages?".
  if [ -f "$PROFILE/Default/Preferences" ]; then
    sed -i 's/"exited_cleanly":false/"exited_cleanly":true/; s/"exit_type":"[^"]*"/"exit_type":"Normal"/' \
      "$PROFILE/Default/Preferences"
  fi
  # Per-site zoom (Chromium's own page zoom, remembered in the profile):
  # Apple Music at ${APPLE_MUSIC_ZOOM:-75}% shows its full desktop layout with the sidebar.
  python3 - "$PROFILE/Default/Preferences" "${APPLE_MUSIC_ZOOM:-75}" <<'PY' || log "could not set Apple Music zoom"
import json, math, os, sys, time
path, pct = sys.argv[1], float(sys.argv[2])
os.makedirs(os.path.dirname(path), exist_ok=True)
try:
    with open(path) as f:
        prefs = json.load(f)
except (OSError, ValueError):
    prefs = {}
levels = prefs.setdefault("partition", {}).setdefault("per_host_zoom_levels", {}).setdefault("x", {})
stamp = str(int((time.time() + 11644473600) * 1e6))   # Chromium time (microseconds since 1601)
for host in ("music.apple.com", "beta.music.apple.com"):
    if pct and pct != 100:
        levels[host] = {"last_modified": stamp, "zoom_level": math.log(pct / 100) / math.log(1.2)}
    else:
        levels.pop(host, None)
prefs.get("browser", {}).pop("window_placement", None)   # a remembered smaller window must not win
with open(path, "w") as f:
    json.dump(prefs, f)
PY
  apply_rotation
  # Size the window to the whole screen. Without a window manager, Chromium can open smaller
  # than a big monitor (e.g. only the left half of an ultrawide).
  SIZE=$(xrandr 2>/dev/null | sed -n 's/.*current \([0-9]*\) x \([0-9]*\).*/\1,\2/p' | head -1)
  WINDOW_ARGS=()
  [ -n "$SIZE" ] && WINDOW_ARGS=(--window-position=0,0 "--window-size=$SIZE")
  log "starting $BROWSER (screen ${SIZE:-unknown})"
  "$BROWSER" \
    --kiosk \
    --user-data-dir="$PROFILE" \
    --remote-debugging-address=127.0.0.1 \
    --remote-debugging-port=9222 \
    --remote-allow-origins=http://127.0.0.1 \
    --force-device-scale-factor="$SCALE" \
    --noerrdialogs --disable-infobars --disable-session-crashed-bubble \
    --no-first-run --no-default-browser-check --password-store=basic \
    --autoplay-policy=no-user-gesture-required \
    --disable-background-timer-throttling \
    --disable-renderer-backgrounding \
    --disable-backgrounding-occluded-windows \
    --disable-features=Translate,MediaRouter \
    --overscroll-history-navigation=0 \
    --disable-pinch \
    --check-for-update-interval=31536000 \
    "${WINDOW_ARGS[@]}" \
    "$LAUNCHER"
  log "$BROWSER exited ($?), restarting in 2s"
  sleep 2
done
