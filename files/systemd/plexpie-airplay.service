[Unit]
Description=PlexPie AirPlay 2 receiver (shairport-sync)
After=network-online.target avahi-daemon.service nqptp.service user@@UID@.service
Wants=network-online.target nqptp.service
Requires=avahi-daemon.service

[Service]
Type=simple
User=@USER@
Group=@USER@
Environment=HOME=@HOME@
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
ExecStart=/usr/local/bin/shairport-sync -c /etc/plexpie/shairport-sync.conf
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
