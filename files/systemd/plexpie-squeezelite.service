[Unit]
Description=PlexPie Music Assistant player (Squeezelite)
After=network-online.target user@@UID@.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
Environment=HOME=@HOME@
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
EnvironmentFile=/etc/plexpie/plexpie.conf
# -s: Music Assistant lives on another subnet, so no auto-discovery.
# -C 5: let go of the audio device 5 s after playback stops.
ExecStart=/usr/bin/squeezelite -n "${PLAYER_NAME}" -s ${HA_HOST} -o default -C 5
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
