[Unit]
Description=PlexPie Music Assistant player (Squeezelite)
After=network-online.target user@@UID@.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
Environment=HOME=@HOME@
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
EnvironmentFile=/etc/plexpie/plexpie.conf
# -s: the Music Assistant server (MA_HOST, else HA_HOST; empty = auto-discover on this subnet)
# -C 5: let go of the audio device 5 s after playback stops.
# ($$ hands the variables to the shell instead of systemd)
ExecStart=/bin/sh -c 'S="$${MA_HOST:-$$HA_HOST}"; exec /usr/bin/squeezelite -n "$$PLAYER_NAME" $${S:+-s "$$S"} -o default -C 5'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
